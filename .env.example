# ---- Site (Next.js) ---------------------------------------------------------
# No Easypanel: configure como variaveis de ambiente/build args do servico.
NEXT_PUBLIC_SUPABASE_URL=https://bzthdklqvjtutkeiimpq.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<sua-anon-key>

# ---- Edge Functions (Supabase > Project Settings > Edge Functions > Secrets)
# Configure com: supabase secrets set NOME=valor --project-ref bzthdklqvjtutkeiimpq
# NUNCA commite os valores reais.

STRIPE_SECRET_KEY=<sk_live_...>
STRIPE_WEBHOOK_SECRET=<whsec_...>          # criado ao registrar o webhook na Stripe
MERCOSULPAY_API_KEY=<chave-mercosulpay>
MERCOSULPAY_WEBHOOK_SECRET=<segredo-webhook-mercosulpay>
SITE_URL=https://seu-dominio.com           # usado p/ redirect do Stripe Checkout

# SUPABASE_URL / SUPABASE_ANON_KEY / SUPABASE_SERVICE_ROLE_KEY ja sao
# injetados automaticamente pelo Supabase nas edge functions.
